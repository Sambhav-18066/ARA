    # ==================================================
    # WEBSITE CONTROL
    # ==================================================

    def _route_website(
        self,
        text: str,
    ):

        match = re.fullmatch(
            r"(?:open|visit|go\s+to)\s+(.+)",
            text,
            flags=re.IGNORECASE,
        )

        if not match:
            return None

        website = (
            match
            .group(1)
            .strip()
        )

        if not website:
            return None

        website_lower = (
            website
            .lower()
            .strip()
        )

        # --------------------------------------------------
        # KNOWN WEBSITE ALIAS
        # --------------------------------------------------

        alias = (
            website_lower
            .removeprefix("www.")
        )

        url = self.WEBSITES.get(
            alias
        )

        if url:

            return Intent(
                intent="open_website",
                skill="browser",
                action="open",
                parameters={
                    "url": url,
                },
                confidence=1.0,
            )

        # --------------------------------------------------
        # LOCAL FILE EXTENSION PROTECTION
        #
        # Obvious filenames must not become fake domains.
        #
        # Examples:
        #   yajnya.png
        #   report.pdf
        #   main.py
        # --------------------------------------------------

        local_file_extensions = {
            # Images
            ".png",
            ".jpg",
            ".jpeg",
            ".gif",
            ".bmp",
            ".webp",
            ".svg",
            ".ico",

            # Documents
            ".pdf",
            ".txt",
            ".doc",
            ".docx",
            ".rtf",
            ".odt",

            # Spreadsheets
            ".xls",
            ".xlsx",
            ".csv",
            ".ods",

            # Presentations
            ".ppt",
            ".pptx",
            ".odp",

            # Code / data
            ".py",
            ".js",
            ".ts",
            ".jsx",
            ".tsx",
            ".java",
            ".cpp",
            ".c",
            ".h",
            ".cs",
            ".go",
            ".rs",
            ".php",
            ".rb",
            ".json",
            ".xml",
            ".yaml",
            ".yml",
            ".toml",
            ".ini",
            ".cfg",
            ".md",

            # Archives
            ".zip",
            ".rar",
            ".7z",
            ".tar",
            ".gz",

            # Audio
            ".mp3",
            ".wav",
            ".flac",
            ".aac",
            ".m4a",
            ".ogg",

            # Video
            ".mp4",
            ".mkv",
            ".avi",
            ".mov",
            ".wmv",
            ".webm",

            # Windows / executable
            ".exe",
            ".msi",
            ".lnk",
            ".bat",
            ".cmd",
            ".ps1",
        }

        filename_candidate = (
            website_lower
            .split("?", 1)[0]
            .split("#", 1)[0]
            .rstrip("/")
        )

        explicit_scheme = (
            website_lower.startswith(
                (
                    "http://",
                    "https://",
                )
            )
        )

        if not explicit_scheme:

            for extension in local_file_extensions:

                if filename_candidate.endswith(
                    extension
                ):
                    return None

        # --------------------------------------------------
        # EXPLICIT DOMAIN / URL
        # --------------------------------------------------

        if re.fullmatch(
            r"(?:https?://)?"
            r"(?:www\.)?"
            r"[a-z0-9.-]+\.[a-z]{2,}"
            r"(?::\d+)?"
            r"(?:/[^\s]*)?",
            website_lower,
            flags=re.IGNORECASE,
        ):

            if not website_lower.startswith(
                (
                    "http://",
                    "https://",
                )
            ):

                website_lower = (
                    "https://"
                    + website_lower
                )

            return Intent(
                intent="open_website",
                skill="browser",
                action="open",
                parameters={
                    "url": website_lower,
                },
                confidence=1.0,
            )

        return None

    # ==================================================
    # WEB SEARCH
    # ==================================================

    def _route_search(
        self,
        text: str,
    ):

        text = (
            str(text)
            .strip()
        )

        if not text:
            return None

        # More specific forms MUST come before
        # generic "search ..." patterns.

        patterns = (
            # Google
            r"search\s+google\s+for\s+(.+)",
            r"search\s+google\s+(.+)",

            # Internet / web
            r"search\s+(?:the\s+)?internet\s+for\s+(.+)",
            r"search\s+(?:the\s+)?web\s+for\s+(.+)",
            r"search\s+online\s+for\s+(.+)",

            # Natural lookup language
            r"look\s+up\s+(.+)",
            r"lookup\s+(.+)",
            r"find\s+online\s+(.+)",
            r"find\s+on\s+(?:the\s+)?internet\s+(.+)",
            r"find\s+on\s+(?:the\s+)?web\s+(.+)",

            # Generic search
            r"search\s+for\s+(.+)",
            r"search\s+(.+)",

            # Google used as a verb
            r"google\s+(.+)",
        )

        for pattern in patterns:

            match = re.fullmatch(
                pattern,
                text,
                flags=re.IGNORECASE,
            )

            if not match:
                continue

            query = (
                match
                .group(1)
                .strip()
            )

            if not query:
                return None

            return Intent(
                intent="web_search",
                skill="browser",
                action="search",
                parameters={
                    "query": query,
                },
                confidence=1.0,
            )

        return None

