    # ==================================================
    # CALCULATOR
    # ==================================================

    def _route_calculator(
        self,
        text: str,
    ):

        expression = text.strip()

        prefixes = (
            "calculate ",
            "compute ",
            "what is ",
            "what's ",
        )

        prefix_found = False

        for prefix in prefixes:

            if expression.startswith(
                prefix
            ):

                expression = expression[
                    len(prefix):
                ].strip()

                prefix_found = True

                break

        # --------------------------------------------------
        # CLEAN EXPRESSION
        # --------------------------------------------------

        expression = (
            expression
            .rstrip("?")
            .strip()
        )

        expression = (
            expression
            .replace("×", "*")
            .replace("÷", "/")
        )

        if not expression:
            return None

        # Must contain a number.

        if not re.search(
            r"\d",
            expression,
        ):

            return None

        # Only arithmetic characters allowed.

        if not re.fullmatch(
            r"[0-9\s+\-*/%.()]+",
            expression,
        ):

            return None

        # A standalone number should not accidentally
        # become a calculation unless explicitly requested.

        if (
            not prefix_found
            and not re.search(
                r"[+\-*/%]",
                expression,
            )
        ):

            return None

        return Intent(
            intent="calculate",
            skill="calculator",
            action="calculate",
            parameters={
                "expression": expression,
            },
            confidence=1.0,
        )

