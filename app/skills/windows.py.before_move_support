    # ==================================================

    def _mouse_click(self, parameters):

        x = parameters.get(
            "x"
        )

        y = parameters.get(
            "y"
        )

        try:

            # Click specific coordinates.

            if (
                x is not None
                or y is not None
            ):

                if (
                    x is None
                    or y is None
                ):

                    return {
                        "success": False,
                        "message": (
                            "Both X and Y coordinates "
                            "are required."
                        ),
                    }

                coordinates = (
                    self._validate_coordinates(
                        x,
                        y,
                    )
                )

                if coordinates is None:

                    return {
                        "success": False,
                        "message": (
                            "Click coordinates are "
                            "outside the screen."
