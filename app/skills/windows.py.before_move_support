import os
import shutil
import time

import pyautogui
import pygetwindow as gw
from pathlib import Path

from app.skills.base import Skill
from app.windows.application_resolver import ApplicationResolver
from app.windows.file_resolver import FileResolver


# PyAutoGUI emergency failsafe.
# Moving the mouse to the top-left corner can abort automation.
pyautogui.FAILSAFE = True


class WindowsSkill(Skill):

    name = "windows"

    # ==================================================
    # SUPPORTED APPLICATIONS
    # ==================================================

    APPS = {
        "chrome": r"C:\Program Files\Google\Chrome\Application\chrome.exe",
        "notepad": "notepad.exe",
        "calculator": "calc.exe",
        "paint": "mspaint.exe",
    }

    # ==================================================
    # INITIALIZATION
    # ==================================================

    def __init__(self):

        # Dynamic resolver indexes applications exposed
        # through the Windows Start Menu.
        self.application_resolver = ApplicationResolver()

        # Local resolver searches common user locations
        # for files and folders.
        self.file_resolver = FileResolver()

    # ==================================================
    # MAIN EXECUTOR
    # ==================================================

    def execute(self, action, parameters):

        if parameters is None:
            parameters = {}

        # Applications / filesystem resources
        if action == "open":
            return self._open_application(parameters)

        if action == "copy":
            return self._copy_resource(parameters)

        # Keyboard
        if action == "type":
            return self._type_text(parameters)

        if action == "hotkey":
            return self._hotkey(parameters)

        if action == "press":
            return self._press_key(parameters)

        # Windows
        if action == "active_window":
            return self._active_window()

        if action == "list_windows":
            return self._list_windows()

        if action == "focus":
            return self._focus_window(parameters)

        if action == "wait_for_window":
            return self._wait_for_window(parameters)

        if action == "minimize":
            return self._minimize_window(parameters)

        if action == "maximize":
            return self._maximize_window(parameters)

        if action == "restore":
            return self._restore_window(parameters)

        if action == "close":
            return self._close_window(parameters)

        # Mouse
        if action == "mouse_position":
            return self._mouse_position()

        if action == "mouse_move":
            return self._mouse_move(parameters)

        if action == "click":
            return self._mouse_click(parameters)

        if action == "double_click":
            return self._mouse_double_click(parameters)

        if action == "right_click":
            return self._mouse_right_click(parameters)

        if action == "scroll":
            return self._mouse_scroll(parameters)

        return {
            "success": False,
            "message": f"Unknown Windows action: {action}",
        }

    # ==================================================
    # COPY FILE / FOLDER
    # ==================================================

    def _copy_resource(
        self,
        parameters,
    ):

        source_query = (
            str(parameters.get("source", ""))
            .strip()
        )

        destination_query = (
            str(parameters.get("destination", ""))
            .strip()
        )

        if not source_query:

            return {
                "success": False,
                "message": "No copy source specified.",
                "reason": "copy_source_missing",
            }

        if not destination_query:

            return {
                "success": False,
                "message": "No copy destination specified.",
                "reason": "copy_destination_missing",
            }

        # --------------------------------------------------
        # RESOLVE SOURCE
        # --------------------------------------------------

        try:

            source_resolution = (
                self.file_resolver.resolve(
                    source_query
                )
            )

        except Exception as error:

            return {
                "success": False,
                "message": (
                    f"Could not resolve source "
                    f"'{source_query}': {error}"
                ),
                "reason": "copy_source_resolver_error",
            }

        if not source_resolution.get("success"):

            return {
                "success": False,
                "message": (
                    f"Copy source '{source_query}' "
                    "could not be found."
                ),
                "reason": "copy_source_not_found",
                "source_resolution": source_resolution,
            }

        source_resource = (
            source_resolution.get(
                "resource",
                {},
            )
        )

        source_path_text = (
            source_resource.get("path")
        )

        if not source_path_text:

            return {
                "success": False,
                "message": (
                    "Copy source was resolved, "
                    "but no source path was available."
                ),
                "reason": "copy_source_path_missing",
                "source_resolution": source_resolution,
            }

        source_path = Path(
            source_path_text
        )

        if not source_path.exists():

            return {
                "success": False,
                "message": (
                    f"Copy source '{source_path}' "
                    "does not exist."
                ),
                "reason": "copy_source_not_found",
            }

        # --------------------------------------------------
        # RESOLVE DESTINATION
        # --------------------------------------------------

        try:

            destination_resolution = (
                self.file_resolver.resolve(
                    destination_query
                )
            )

        except Exception as error:

            return {
                "success": False,
                "message": (
                    f"Could not resolve destination "
                    f"'{destination_query}': {error}"
                ),
                "reason": (
                    "copy_destination_resolver_error"
                ),
            }

        if not destination_resolution.get("success"):

            return {
                "success": False,
                "message": (
                    f"Copy destination "
                    f"'{destination_query}' "
                    "could not be found."
                ),
                "reason": "copy_destination_not_found",
                "destination_resolution": (
                    destination_resolution
                ),
            }

        destination_resource = (
            destination_resolution.get(
                "resource",
                {},
            )
        )

        destination_path_text = (
            destination_resource.get("path")
        )

        if not destination_path_text:

            return {
                "success": False,
                "message": (
                    "Copy destination was resolved, "
                    "but no destination path "
                    "was available."
                ),
                "reason": (
                    "copy_destination_path_missing"
                ),
                "destination_resolution": (
                    destination_resolution
                ),
            }

        destination_folder = Path(
            destination_path_text
        )

        if not destination_folder.exists():

            return {
                "success": False,
                "message": (
                    f"Destination "
                    f"'{destination_folder}' "
                    "does not exist."
                ),
                "reason": "copy_destination_not_found",
            }

        if not destination_folder.is_dir():

            return {
                "success": False,
                "message": (
                    f"Destination "
                    f"'{destination_folder}' "
                    "is not a folder."
                ),
                "reason": (
                    "copy_destination_not_folder"
                ),
            }

        # --------------------------------------------------
        # BUILD FINAL TARGET
        # --------------------------------------------------

        target_path = (
            destination_folder
            / source_path.name
        )

        try:

            source_absolute = (
                source_path.resolve()
            )

            destination_absolute = (
                destination_folder.resolve()
            )

            target_absolute = (
                target_path.resolve()
            )

        except Exception as error:

            return {
                "success": False,
                "message": (
                    f"Could not prepare copy paths: "
                    f"{error}"
                ),
                "reason": "copy_path_error",
            }

        # Source and final target cannot be identical.

        if source_absolute == target_absolute:

            return {
                "success": False,
                "message": (
                    "Source and destination refer "
                    "to the same resource."
                ),
                "reason": "copy_same_resource",
                "source": str(source_absolute),
                "target": str(target_absolute),
            }

        # Do not copy a folder into itself or one of
        # its descendants.

        if source_path.is_dir():

            try:

                destination_absolute.relative_to(
                    source_absolute
                )

                return {
                    "success": False,
                    "message": (
                        "A folder cannot be copied "
                        "into itself."
                    ),
                    "reason": (
                        "copy_destination_inside_source"
                    ),
                    "source": str(source_absolute),
                    "destination": str(
                        destination_absolute
                    ),
                }

            except ValueError:
                pass

        # Version one deliberately refuses overwrite.
        # Later we can add explicit:
        #
        #   overwrite X to Y
        #   replace existing file
        #
        # with confirmation policy.

        if target_path.exists():

            return {
                "success": False,
                "message": (
                    f"'{target_path.name}' already "
                    f"exists in "
                    f"'{destination_folder}'."
                ),
                "reason": "copy_target_exists",
                "source": str(source_path),
                "destination": str(
                    destination_folder
                ),
                "target": str(target_path),
            }

        # --------------------------------------------------
        # COPY
        # --------------------------------------------------

        try:

            if source_path.is_dir():

                shutil.copytree(
                    source_path,
                    target_path,
                )

                resource_type = "folder"

            else:

                shutil.copy2(
                    source_path,
                    target_path,
                )

                resource_type = "file"

        except Exception as error:

            return {
                "success": False,
                "message": (
                    f"Could not copy "
                    f"'{source_path.name}': {error}"
                ),
                "reason": "copy_failed",
                "source": str(source_path),
                "destination": str(
                    destination_folder
                ),
                "target": str(target_path),
            }

        return {
            "success": True,
            "message": (
                f"Copied {source_path.name} to "
                f"{destination_folder}."
            ),
            "resource": source_path.name,
            "resource_type": resource_type,
            "source": str(source_path),
            "destination": str(
                destination_folder
            ),
            "target": str(target_path),
            "operation": "copy",
        }

    # ==================================================
    # OPEN APPLICATION
    # ==================================================

    def _open_application(self, parameters):

        application = (
            str(parameters.get("application", ""))
            .strip()
        )

        if not application:
            return {
                "success": False,
                "message": "No application specified.",
                "reason": "application_missing",
            }

        application_key = application.lower()

        # --------------------------------------------------
        # STRONG FILESYSTEM PRIORITY
        # --------------------------------------------------
        #
        # Resolve explicit/high-confidence filesystem
        # resources before fuzzy application matching.
        #
        # Examples:
        #
        #   Desktop
        #   Downloads
        #   Pictures
        #   images
        #   Program Files
        #   E:
        #   E:\
        #   C:\Users\Name\file.txt
        #
        # Ordinary searched files do NOT win here.
        # They remain the fallback after application
        # resolution.
        # --------------------------------------------------

        try:

            strong_file_resolution = (
                self.file_resolver.resolve(
                    application
                )
            )

        except Exception:

            strong_file_resolution = None

        if (
            strong_file_resolution
            and strong_file_resolution.get("success")
        ):

            strong_resource = (
                strong_file_resolution.get(
                    "resource",
                    {},
                )
            )

            strong_match_type = (
                strong_resource.get(
                    "match_type"
                )
            )

            strong_match_types = {
                "known_folder",
                "drive_root",
                "direct_path",
            }

            if strong_match_type in strong_match_types:

                strong_path = (
                    strong_resource.get(
                        "path"
                    )
                )

                strong_name = (
                    strong_resource.get(
                        "name"
                    )
                    or application
                )

                strong_type = (
                    strong_resource.get(
                        "type",
                        "resource",
                    )
                )

                if not strong_path:

                    return {
                        "success": False,
                        "message": (
                            f"ARA resolved "
                            f"'{application}', but no "
                            "filesystem path was "
                            "available."
                        ),
                        "reason": (
                            "resource_path_missing"
                        ),
                        "resolution": (
                            strong_file_resolution
                        ),
                    }

                try:

                    os.startfile(
                        strong_path
                    )

                    return {
                        "success": True,
                        "message": (
                            f"Opened {strong_name}."
                        ),
                        "resource": strong_name,
                        "resource_type": strong_type,
                        "launch_source": (
                            "filesystem_priority"
                        ),
                        "target": strong_path,
                        "resolution": (
                            strong_file_resolution
                        ),
                    }

                except Exception as error:

                    return {
                        "success": False,
                        "message": (
                            f"Could not open "
                            f"{strong_name}: {error}"
                        ),
                        "reason": (
                            "resource_open_failed"
                        ),
                        "resource": (
                            strong_resource
                        ),
                        "resolution": (
                            strong_file_resolution
                        ),
                    }

        # --------------------------------------------------
        # BUILT-IN FAST PATH
        # --------------------------------------------------

        executable = self.APPS.get(
            application_key
        )

        if executable:

            try:

                os.startfile(executable)

                return {
                    "success": True,
                    "message": f"{application} launched.",
                    "application": application,
                    "launch_source": "builtin",
                    "target": executable,
                }

            except Exception as error:

                return {
                    "success": False,
                    "message": (
                        f"Could not launch "
                        f"{application}: {error}"
                    ),
                    "reason": "builtin_launch_failed",
                }

        # --------------------------------------------------
        # DYNAMIC APPLICATION RESOLUTION
        # --------------------------------------------------

        try:

            resolution = (
                self.application_resolver.resolve(
                    application
                )
            )

        except Exception as error:

            return {
                "success": False,
                "message": (
                    "Application resolution failed: "
                    f"{error}"
                ),
                "reason": "resolver_error",
            }

        # --------------------------------------------------
        # APPLICATION FOUND
        # --------------------------------------------------

        if resolution.get("success"):

            resolved = resolution.get(
                "application",
                {},
            )

            shortcut = resolved.get(
                "shortcut"
            )

            resolved_name = resolved.get(
                "name",
                application,
            )

            if not shortcut:

                return {
                    "success": False,
                    "message": (
                        f"ARA resolved '{application}', "
                        "but no launch target was available."
                    ),
                    "reason": "launch_target_missing",
                    "resolution": resolution,
                }

            try:

                os.startfile(
                    shortcut
                )

                return {
                    "success": True,
                    "message": (
                        f"{resolved_name} launched."
                    ),
                    "application": resolved_name,
                    "launch_source": "application_resolver",
                    "target": shortcut,
                    "resolution": resolution,
                }

            except Exception as error:

                return {
                    "success": False,
                    "message": (
                        f"Could not launch "
                        f"{resolved_name}: {error}"
                    ),
                    "reason": "resolved_launch_failed",
                    "resolution": resolution,
                }

        # --------------------------------------------------
        # FILE / FOLDER FALLBACK
        # --------------------------------------------------
        #
        # It wasn't an installed application.
        # Try the same target as a local file/folder.
        # --------------------------------------------------

        try:

            file_resolution = (
                self.file_resolver.resolve(
                    application
                )
            )

        except Exception as error:

            return {
                "success": False,
                "message": (
                    f"Could not resolve "
                    f"'{application}': {error}"
                ),
                "reason": "file_resolver_error",
                "application_resolution": resolution,
            }

        if not file_resolution.get("success"):

            return {
                "success": False,
                "message": (
                    f"Application, file, or folder "
                    f"'{application}' could not be found."
                ),
                "reason": "resource_not_found",
                "application_resolution": resolution,
                "file_resolution": file_resolution,
            }

        resource = file_resolution.get(
            "resource",
            {},
        )

        resource_path = resource.get(
            "path"
        )

        resource_name = resource.get(
            "name",
            application,
        )

        resource_type = resource.get(
            "type",
            "resource",
        )

        if not resource_path:

            return {
                "success": False,
                "message": (
                    f"ARA resolved '{application}', "
                    "but no file path was available."
                ),
                "reason": "resource_path_missing",
                "file_resolution": file_resolution,
            }

        # --------------------------------------------------
        # OPEN FILE / FOLDER
        # --------------------------------------------------

        try:

            os.startfile(
                resource_path
            )

            return {
                "success": True,
                "message": (
                    f"Opened {resource_name}."
                ),
                "resource": resource_name,
                "resource_type": resource_type,
                "launch_source": "file_resolver",
                "target": resource_path,
                "resolution": file_resolution,
            }

        except Exception as error:

            return {
                "success": False,
                "message": (
                    f"Could not open "
                    f"{resource_name}: {error}"
                ),
                "reason": "resource_open_failed",
                "resource": resource,
                "resolution": file_resolution,
            }

    # ==================================================
    # ACTIVE WINDOW
    # ==================================================

    def _active_window(self):

        try:

            window = gw.getActiveWindow()

            if window is None:

                return {
                    "success": False,
                    "message": "No active window detected.",
                }

            return {
                "success": True,
                "message": (
                    f"Active window: {window.title}"
                ),
                "data": {
                    "title": window.title,
                },
            }

        except Exception as error:

            return {
                "success": False,
                "message": (
                    "Could not detect active window: "
                    f"{error}"
                ),
            }

    # ==================================================
    # LIST WINDOWS
    # ==================================================

    def _list_windows(self):

        try:

            titles = []

            for window in gw.getAllWindows():

                title = window.title.strip()

                if title and title not in titles:

                    titles.append(
                        title
                    )

            return {
                "success": True,
                "message": (
                    f"Found {len(titles)} open windows."
                ),
                "data": {
                    "windows": titles,
                },
            }

        except Exception as error:

            return {
                "success": False,
                "message": (
                    f"Could not list windows: {error}"
                ),
            }

    # ==================================================
    # FIND WINDOW
    # ==================================================

    def _find_window(self, title):

        if not title:
            return None

        target = (
            str(title)
            .lower()
            .strip()
        )

        if not target:
            return None

        try:

            windows = gw.getAllWindows()

            # Exact title first.

            for window in windows:

                window_title = (
                    window.title
                    .lower()
                    .strip()
                )

                if window_title == target:

                    return window

            # Then partial title match.

            for window in windows:

                window_title = (
                    window.title
                    .lower()
                    .strip()
                )

                if target in window_title:

                    return window

            return None

        except Exception:

            return None

    # ==================================================
    # WAIT FOR WINDOW
    # ==================================================

    def _wait_for_window(self, parameters):

        title = (
            str(parameters.get("title", ""))
            .strip()
        )

        timeout = parameters.get(
            "timeout",
            10,
        )

        try:

            timeout = float(
                timeout
            )

        except (TypeError, ValueError):

            timeout = 10

        timeout = max(
            0.5,
            min(timeout, 60),
        )

        if not title:

            return {
                "success": False,
                "message": "No window title specified.",
            }

        start = time.time()

        while (
            time.time() - start
            < timeout
        ):

            window = self._find_window(
                title
            )

            if window:

                return {
                    "success": True,
                    "message": (
                        f"Window found: "
                        f"{window.title}"
                    ),
                    "data": {
                        "title": window.title,
                    },
                }

            time.sleep(
                0.2
            )

        return {
            "success": False,
            "message": (
                f"Timed out waiting for "
                f"window '{title}'."
            ),
        }

    # ==================================================
    # FOCUS WINDOW
    # ==================================================

    def _focus_window(self, parameters):

        title = (
            str(parameters.get("title", ""))
            .strip()
        )

        if not title:

            return {
                "success": False,
                "message": "No window title specified.",
            }

        try:

            window = self._find_window(
                title
            )

            if window is None:

                return {
                    "success": False,
                    "message": (
                        f"Window '{title}' "
                        "was not found."
                    ),
                }

            # Restore first if minimized.

            if window.isMinimized:

                window.restore()

                time.sleep(
                    0.3
                )

            try:

                window.activate()

            except Exception as error:

                # PyGetWindow can occasionally report an
                # error even though Windows activated it.

                print(
                    "[WINDOW WARNING] "
                    f"activate(): {error}"
                )

            # --------------------------------------------------
            # VERIFY FOCUS
            # --------------------------------------------------

            start = time.time()

            target_title = (
                window.title
                .lower()
                .strip()
            )

            requested_title = (
                title
                .lower()
                .strip()
            )

            while (
                time.time() - start
                < 2.0
            ):

                active = (
                    gw.getActiveWindow()
                )

                if active is not None:

                    active_title = (
                        active.title
                        .lower()
                        .strip()
                    )

                    if (
                        active_title
                        == target_title
                    ):

                        return {
                            "success": True,
                            "message": (
                                "Focused window: "
                                f"{window.title}"
                            ),
                            "data": {
                                "title": window.title,
                            },
                        }

                    if (
                        requested_title
                        in active_title
                    ):

                        return {
                            "success": True,
                            "message": (
                                "Focused window: "
                                f"{active.title}"
                            ),
                            "data": {
                                "title": active.title,
                            },
                        }

                time.sleep(
                    0.1
                )

            active = (
                gw.getActiveWindow()
            )

            active_title = (
                active.title
                if active is not None
                else "Unknown"
            )

            return {
                "success": False,
                "message": (
                    "Could not verify focus on "
                    f"'{window.title}'. "
                    "Active window is "
                    f"'{active_title}'."
                ),
            }

        except Exception as error:

            return {
                "success": False,
                "message": (
                    "Could not focus window "
                    f"'{title}': {error}"
                ),
            }

    # ==================================================
    # MINIMIZE WINDOW
    # ==================================================

    def _minimize_window(self, parameters):

        title = (
            str(parameters.get("title", ""))
            .strip()
        )

        if not title:

            return {
                "success": False,
                "message": "No window title specified.",
            }

        try:

            window = self._find_window(
                title
            )

            if window is None:

                return {
                    "success": False,
                    "message": (
                        f"Window '{title}' "
                        "was not found."
                    ),
                }

            actual_title = (
                window.title
            )

            if window.isMinimized:

                return {
                    "success": True,
                    "message": (
                        "Window already minimized: "
                        f"{actual_title}"
                    ),
                }

            window.minimize()

            time.sleep(
                0.2
            )

            return {
                "success": True,
                "message": (
                    f"Minimized window: "
                    f"{actual_title}"
                ),
            }

        except Exception as error:

            return {
                "success": False,
                "message": (
                    "Could not minimize "
                    f"'{title}': {error}"
                ),
            }

    # ==================================================
    # MAXIMIZE WINDOW
    # ==================================================

    def _maximize_window(self, parameters):

        title = (
            str(parameters.get("title", ""))
            .strip()
        )

        if not title:

            return {
                "success": False,
                "message": "No window title specified.",
            }

        try:

            window = self._find_window(
                title
            )

            if window is None:

                return {
                    "success": False,
                    "message": (
                        f"Window '{title}' "
                        "was not found."
                    ),
                }

            actual_title = (
                window.title
            )

            if window.isMinimized:

                window.restore()

                time.sleep(
                    0.2
                )

            if window.isMaximized:

                return {
                    "success": True,
                    "message": (
                        "Window already maximized: "
                        f"{actual_title}"
                    ),
                }

            window.maximize()

            time.sleep(
                0.2
            )

            return {
                "success": True,
                "message": (
                    f"Maximized window: "
                    f"{actual_title}"
                ),
            }

        except Exception as error:

            return {
                "success": False,
